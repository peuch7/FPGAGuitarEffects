# sources.tcl - GENERATED by scripts/fx.py, do not edit.
#
# Adds every RTL file the bitstream needs to the open Vivado project and sets
# the include path. vivado/create_project.tcl sources it. After adding or
# removing an effect, re-source it from the Vivado Tcl console:
#
#     source <repo>/gen/vivado/sources.tcl
#
# It is idempotent, and drops repo files that are no longer in the build (an
# effect that was removed), so an open project follows the effect list.

set fx_repo [file normalize [file join [file dirname [info script]] .. ..]]

set fx_rtl {
    router/rtl/patch_ram.sv
    router/rtl/router_pl.sv
    router/rtl/routing.sv
    effects/overdrive/rtl/overdrive.sv
    effects/overdrive/rtl/overdrive_top.sv
    effects/distortion/rtl/distortion.sv
    effects/distortion/rtl/distortion_top.sv
    effects/delay/rtl/delay.sv
    effects/delay/rtl/delay_top.sv
    effects/echo/rtl/echo.sv
    effects/echo/rtl/echo_top.sv
    effects/chorus/rtl/chorus.sv
    effects/chorus/rtl/chorus_top.sv
    effects/reverb/rtl/reverb.sv
    effects/reverb/rtl/reverb_top.sv
    gen/rtl/effect_bank.sv
    rtl/bclk_div.sv
    rtl/i2s_rx.sv
    rtl/i2s_tx.sv
}

set fx_headers {
    router/rtl/effect_contract.svh
    gen/rtl/router_patch.svh
    effects/overdrive/rtl/tanh_lut.svh
    effects/chorus/rtl/chorus_sine_table.svh
}

set fx_include_dirs {
    router/rtl
    gen/rtl
    effects/overdrive/rtl
    effects/chorus/rtl
}

proc fx_abs {rel} {
    global fx_repo
    return [file normalize [file join $fx_repo $rel]]
}

# Paths compared as keys: Windows file names are case-insensitive, and Vivado
# may hand back "c:/..." for a file added as "C:/...".
proc fx_key {path} {
    set path [file normalize $path]
    if {$::tcl_platform(platform) eq "windows"} {
        set path [string tolower $path]
    }
    return $path
}

set fx_fs [get_filesets sources_1]
set fx_have [dict create]
foreach f [get_files -quiet -of_objects $fx_fs] {
    dict set fx_have [fx_key $f] $f
}
set fx_want [dict create]
foreach rel [concat $fx_rtl $fx_headers] {
    dict set fx_want [fx_key [fx_abs $rel]] $rel
}
set fx_headers_keys [lmap rel $fx_headers {fx_key [fx_abs $rel]}]

# Repo files from an earlier run that are no longer part of the build.
set fx_root "[fx_key $fx_repo]/"
dict for {key f} $fx_have {
    if {[string first $fx_root $key] != 0 || [dict exists $fx_want $key]} {
        continue
    }
    set rel [string range $key [string length $fx_root] end]
    if {[regexp {^(effects|gen|router|rtl)/} $rel]} {
        puts "fx: removing $rel (no longer in the build)"
        remove_files -fileset $fx_fs $f
    }
}

dict for {key rel} $fx_want {
    if {![dict exists $fx_have $key]} {
        add_files -norecurse -fileset $fx_fs [fx_abs $rel]
    }
}
foreach f [get_files -quiet -of_objects $fx_fs] {
    if {[lsearch -exact $fx_headers_keys [fx_key $f]] >= 0} {
        set_property file_type {Verilog Header} $f
    }
}
set_property include_dirs [lmap d $fx_include_dirs {fx_abs $d}] $fx_fs
puts "fx: [llength $fx_rtl] RTL files, [llength $fx_headers] headers"
