{
  "name": "reverb",
  "description": "Schroeder reverb: four parallel combs into two allpass stages",
  "top": "reverb_top",
  "sources": [
    "rtl/reverb.sv",
    "rtl/reverb_top.sv"
  ],
  "params": [
    {
      "name": "decay",
      "index": 0,
      "default": 0.7,
      "scale": "q16",
      "doc": "Comb feedback. Higher = longer tail."
    },
    {
      "name": "damping",
      "index": 1,
      "default": 0.3,
      "scale": "q16",
      "doc": "Lowpass inside the comb loop, so highs decay first."
    },
    {
      "name": "mix",
      "index": 2,
      "default": 0.3,
      "scale": "q16",
      "doc": "Dry/wet balance."
    }
  ]
}
