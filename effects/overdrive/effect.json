{
  "name": "overdrive",
  "description": "soft-clipping (tanh) overdrive",
  "top": "overdrive_top",
  "sources": [
    "rtl/overdrive.sv",
    "rtl/overdrive_top.sv",
    "rtl/tanh_lut.svh"
  ],
  "params": [
    {
      "name": "drive",
      "index": 0,
      "default": 4,
      "scale": "raw",
      "min": 1,
      "max": 65536,
      "unit": "x",
      "doc": "Gain into the tanh curve."
    },
    {
      "name": "tone",
      "index": 1,
      "default": 0.5,
      "scale": "q16",
      "doc": "Same one-pole tilt as distortion."
    },
    {
      "name": "level",
      "index": 2,
      "default": 0.5,
      "scale": "q16",
      "doc": "Output attenuation."
    },
    {
      "name": "asymmetry",
      "index": 3,
      "default": 0.0,
      "scale": "q16",
      "doc": "0 = symmetric; higher adds even harmonics."
    }
  ],
  "cycles_per_sample": 32,
  "flush_samples": 16,
  "reference_model": "wavsim.refmodels.overdrive:process",
  "status": "drive is Q8.8 in the RTL (256 = 1x) but the manifest calls it a plain gain: use ~2048 for 8x"
}
